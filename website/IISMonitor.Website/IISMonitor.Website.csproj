<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IISMonitor.Website</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Keeps the SMTP password out of appsettings.json during development: dotnet user-secrets set "Email:Smtp:Password" "..." -->
    <UserSecretsId>iismonitor-website</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!-- MimeKit depends on 10.0.0; 10.0.0 to 10.0.12 have known vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
