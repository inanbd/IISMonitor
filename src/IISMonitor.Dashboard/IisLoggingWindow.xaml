<Window x:Class="IISMonitor.Dashboard.IisLoggingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up IIS logging for the Requests tab" Width="720" Height="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="IIS Monitor reads each request from IIS's log stream (ETW). This changes the IIS logging configuration (applicationHost.config); log files are still written as before." />
            <CheckBox x:Name="RequestFields" IsChecked="True" Margin="0,4"
                      Content="All sites: send log entries to ETW and log the client IP, method, bytes sent, user agent and substatus" />
            <TextBlock TextWrapping="Wrap" Foreground="#5F6B7A" FontSize="11" Margin="20,0,0,10"
                       Text="Needed for the Requests tab, Top IPs and the auto blacklist. These are standard W3C fields (most are on by default) and cost almost nothing." />
            <TextBlock FontWeight="SemiBold" Text="Header fields, per site" Margin="0,4,0,2" />
            <TextBlock TextWrapping="Wrap" Foreground="#5F6B7A" FontSize="11" Margin="0,0,0,6"
                       Text="Logs X-Requested-With, Sec-Fetch-Dest/Mode and the response's Content-Type and Content-Disposition (accurate page / XHR / download kinds) and X-Forwarded-For (who is behind a reverse proxy or CDN; needed to block those visitors). IIS turns off kernel-mode caching on a site that logs custom fields, which costs some CPU on sites with a lot of static content, and log file names get an _x suffix." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="Error" Foreground="#C42B1C" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="All" MinWidth="60" Click="OnAll" />
                <Button Content="None" MinWidth="60" Click="OnNone" />
                <Button Content="Apply" IsDefault="True" MinWidth="80" Click="OnApply" />
                <Button Content="Cancel" IsCancel="True" MinWidth="80" />
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="SiteGrid" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Log headers" Binding="{Binding Headers, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                <DataGridTextColumn Header="Site" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Now" Binding="{Binding Now}" IsReadOnly="True" Width="260" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
