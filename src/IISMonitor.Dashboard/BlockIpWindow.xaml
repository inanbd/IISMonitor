<Window x:Class="IISMonitor.Dashboard.BlockIpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Block IP address" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Make IIS refuse requests from" Foreground="{StaticResource MutedBrush}" />
        <TextBox x:Name="Address" IsReadOnly="True" FontSize="18" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,2,0,0" />

        <!-- Shown for private network addresses: probably a proxy or load balancer, not a visitor -->
        <Border x:Name="PrivateWarning" Background="{StaticResource WarningBrush}" BorderBrush="{StaticResource WarningBorderBrush}"
                BorderThickness="1" Padding="8,6" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap"
                       Text="This is a private network address. If your server is behind a load balancer, reverse proxy or CDN, this may be that device, and blocking it would block every visitor." />
        </Border>

        <TextBlock Text="Block it on" FontWeight="SemiBold" Margin="0,12,0,4" />
        <RadioButton x:Name="PoolScope" GroupName="Scope" Margin="0,4,0,2" />
        <TextBlock x:Name="PoolApplications" Margin="20,0,0,4" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" />
        <RadioButton x:Name="ServerScope" GroupName="Scope" Margin="0,4">
            <TextBlock Text="Every site on this server" />
        </RadioButton>

        <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}"
                   Text="IIS will answer every request from this address with 403 Forbidden. You can undo this under &quot;Blocked IP addresses&quot; at the bottom of the IPs &amp; URLs tab." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Block" IsDefault="True" MinWidth="80" Click="OnBlock" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
