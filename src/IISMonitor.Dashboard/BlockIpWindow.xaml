<Window x:Class="IISMonitor.Dashboard.BlockIpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Block an IP address" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="IP address" />
        <TextBox x:Name="Address" Margin="0,4,0,10" Padding="3,2" />

        <TextBlock Text="For how long" />
        <ComboBox x:Name="Duration" Margin="0,4,0,10" HorizontalAlignment="Stretch" DisplayMemberPath="Label" />

        <TextBlock Text="How" />
        <ComboBox x:Name="Method" Margin="0,4,0,4" HorizontalAlignment="Stretch" DisplayMemberPath="Label" />
        <TextBlock TextWrapping="Wrap" Foreground="#5F6B7A" FontSize="11" Margin="0,0,0,10"
                   Text="The firewall drops everything from the address, on every port. Visitors that reach IIS through a reverse proxy or CDN can only be blocked in IIS (IIS IP restrictions, applied in batches)." />

        <TextBlock Text="Note (optional)" />
        <TextBox x:Name="Note" Margin="0,4,0,0" Padding="3,2" />

        <TextBlock x:Name="Error" Foreground="#C42B1C" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Block" IsDefault="True" MinWidth="80" Click="OnBlock" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
